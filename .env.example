# Agent System v2 — environment defaults.
# Copy to `.env` at the repo root: `cp .env.example .env`
# docker compose auto-loads `.env` from the project directory (repo root).
# Every value below has a built-in default in infra/docker-compose.yml, so the
# .env file is optional for the standard local setup.

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=asv2
POSTGRES_PASSWORD=asv2
POSTGRES_DB=asv2

# ---- Backend (api / worker / watcher / scheduler) ----------------------------
# DATABASE_URL is DERIVED inside docker-compose.yml from the POSTGRES_* values
# above as: postgresql+psycopg://<user>:<pass>@postgres:5432/<db>
# (psycopg v3 driver form). It is listed here for reference and for running the
# backend OUTSIDE Docker.
#   In Docker (service-to-service): host is the "postgres" service name.
DATABASE_URL=postgresql+psycopg://asv2:asv2@postgres:5432/asv2
#   Outside Docker (host shell, e.g. `make test` / `make demo`): use localhost.
# DATABASE_URL=postgresql+psycopg://asv2:asv2@localhost:5432/asv2

# Host directories bind-mounted into the backend containers at the SAME path,
# so these values are valid both on the host and inside the container.
ASV2_LLM_WIKI_ROOT=/home/kay/llm_wiki
ASV2_CODEX_OUTPUT_DIR=/mnt/k/WRITTEN_BY_CODEX
ASV2_CLAUDE_OUTPUT_DIR=/mnt/k/WRITTEN_BY_CLAUDE

# Scheduler timezone — drives the 02:00 daily wiki ingest and the
# month-end 04:00 audit jobs (app.scheduler_loop).
TZ=Asia/Seoul

# ---- Frontend (web) ----------------------------------------------------------
# Base URL the React app calls. Baked into the static bundle at IMAGE BUILD time
# (Vite inlines VITE_* vars), passed to the web image as a build arg.
VITE_API_BASE=http://localhost:8000
