# Agent System v2 — React (Vite) frontend image.
# Stage 1: build the static bundle with Node 22.
# Stage 2: serve the built dist/ with nginx (SPA fallback via infra/nginx.conf).
#
# Build context is the repo ROOT (see infra/docker-compose.yml: context: ..).

# ---- build stage -------------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /web

# Install deps first for layer caching. `package*.json` always matches
# package.json (and package-lock.json when present). Fall back to `npm install`
# when no lockfile exists yet.
COPY apps/web/package*.json ./
RUN npm ci || npm install

# Copy the rest of the frontend source and build.
COPY apps/web/ ./

# Vite inlines VITE_* env vars at build time, so VITE_API_BASE must be present
# during `npm run build` (passed from compose as a build arg).
ARG VITE_API_BASE=http://localhost:8000
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build

# ---- serve stage -------------------------------------------------------------
FROM nginx:alpine
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
